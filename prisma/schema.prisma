generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model User {
  id                String       @id @default(cuid())
  name              String?
  email             String?      @unique
  emailVerified     DateTime?
  image             String?
  isAdmin           Boolean      @default(false)
  removedAt         DateTime?
  bankAccountName   String?
  bankSortCode      String?
  bankAccountNumber String?
  accounts          Account[]
  sessions          Session[]
  expenses          Expense[]
  paymentRunsCreated PaymentRun[]
}

model Team {
  id            String   @id @default(cuid())
  name          String   @unique
  approverEmails String[] @default([])
  budgetTarget   Float    @default(0)
  expenses       Expense[]
}

enum PurchaseStatus {
  ALREADY_PURCHASED
  NOT_PURCHASED
}

enum PaymentTiming {
  AFTER_PURCHASE
  ADVANCE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  AWAITING_PURCHASE
  READY_TO_PAY
  PAYMENT_PENDING
  ADVANCE_PAID_AWAITING_RECEIPT
  PAID
  PAYMENT_FAILED
}

enum PaymentStatus {
  NOT_READY
  READY
  EXPORTED
  PAID
  FAILED
}

enum PaymentRunStatus {
  DRAFT
  WISE_RECOVERY_REQUIRED
  WISE_PREPARED
  WISE_FUNDED
  COMPLETED
  CANCELLED
}

enum SettlementStatus {
  NOT_APPLICABLE
  AWAITING_RECEIPT
  SETTLED
  BALANCE_TO_RETURN
  ADDITIONAL_REIMBURSEMENT_REQUIRED
}

model PaymentRun {
  id          String          @id @default(cuid())
  reference   String          @unique
  preparationKey String?      @unique
  wiseBatchGroupId String?
  wiseStatus String?
  status      PaymentRunStatus @default(DRAFT)
  totalAmount Float           @default(0)
  createdAt   DateTime        @default(now())
  exportedAt  DateTime?
  completedAt DateTime?
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  expenses    Expense[]
}


model ReportSchedule {
  id          String   @id @default("default")
  enabled     Boolean  @default(true)
  dayOfMonth  Int      @default(1)
  hour        Int      @default(6)
  timezone    String   @default("Europe/London")
  recipients  String[] @default([])
  lastSentAt  DateTime?
  updatedAt   DateTime @updatedAt
}

model Expense {
  id                 String        @id @default(cuid())
  date               DateTime
  description        String
  amount             Float
  purchaseStatus     PurchaseStatus @default(ALREADY_PURCHASED)
  paymentTiming      PaymentTiming  @default(AFTER_PURCHASE)
  approvedAmount     Float?
  actualAmount       Float?
  advanceAmount      Float?
  settlementStatus   SettlementStatus @default(NOT_APPLICABLE)
  settlementNote     String?
  status             ExpenseStatus @default(PENDING)
  receiptUrl         String?
  receiptDueAt       DateTime?
  lastReminderAt     DateTime?
  reminderCount      Int           @default(0)
  decisionNote       String?
  decidedAt          DateTime?
  submittedAt        DateTime      @default(now())
  purchasedAt        DateTime?
  paymentStatus      PaymentStatus @default(NOT_READY)
  paymentRunId       String?
  paymentRun          PaymentRun? @relation(fields: [paymentRunId], references: [id])
  paymentReference   String?
  paidAt             DateTime?
  team               Team          @relation(fields: [teamId], references: [id])
  teamId             String
  user               User          @relation(fields: [userId], references: [id])
  userId             String
  wiseRecipientId    String?
  wiseTransferId     String?
  wiseBatchGroupId   String?
  wiseStatus         String?
  relatedExpenseId   String?
}
